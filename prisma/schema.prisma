generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model college {
  CollegeID     Int             @id @default(autoincrement())
  CollegeName   String          @db.VarChar(150)
  CollegeCode   String          @unique(map: "CollegeCode") @db.VarChar(50)
  Email         String?         @db.VarChar(100)
  IsActive      Boolean?        @default(true)
  CreatedAt     DateTime?       @default(now()) @db.DateTime(0)
  UpdatedAt     DateTime?       @default(now()) @db.DateTime(0)
  Address       String?         @db.Text
  Phone         String?         @db.VarChar(20)
  staff         staff[]
  student       student[]
  studentmentor studentmentor[]
  users         users[]
}

model staff {
  StaffID       Int             @id @default(autoincrement())
  UserID        Int
  CollegeID     Int
  StaffName     String          @db.VarChar(150)
  MobileNo      String?         @db.VarChar(15)
  EmailAddress  String?         @db.VarChar(50)
  Description   String?         @db.Text
  CreatedAt     DateTime?       @default(now()) @db.DateTime(0)
  UpdatedAt     DateTime?       @default(now()) @db.DateTime(0)
  college       college         @relation(fields: [CollegeID], references: [CollegeID], map: "fk_staff_college")
  users         users           @relation(fields: [UserID], references: [UserID], onDelete: Cascade, map: "fk_staff_user")
  studentmentor studentmentor[]

  @@index([CollegeID], map: "fk_staff_college")
  @@index([UserID], map: "fk_staff_user")
}

model student {
  StudentID     Int             @id @default(autoincrement())
  UserID        Int
  CollegeID     Int
  StudentName   String          @db.VarChar(150)
  EnrollmentNo  String          @unique(map: "EnrollmentNo") @db.VarChar(50)
  MobileNo      String?         @db.VarChar(15)
  EmailAddress  String?         @db.VarChar(50)
  Description   String?         @db.Text
  CreatedAt     DateTime?       @default(now()) @db.DateTime(0)
  UpdatedAt     DateTime?       @default(now()) @db.DateTime(0)
  college       college         @relation(fields: [CollegeID], references: [CollegeID], map: "fk_student_college")
  users         users           @relation(fields: [UserID], references: [UserID], onDelete: Cascade, map: "fk_student_user")
  studentmentor studentmentor[]

  @@index([CollegeID], map: "fk_student_college")
  @@index([UserID], map: "fk_student_user")
}

model studentmentor {
  StudentMentorID  Int                @id @default(autoincrement())
  StudentID        Int
  StaffID          Int
  CollegeID        Int
  FromDate         DateTime           @db.Date
  ToDate           DateTime?          @db.Date
  Description      String?            @db.Text
  CreatedAt        DateTime?          @default(now()) @db.DateTime(0)
  UpdatedAt        DateTime?          @default(now()) @db.DateTime(0)
  college          college            @relation(fields: [CollegeID], references: [CollegeID], map: "fk_sm_college")
  staff            staff              @relation(fields: [StaffID], references: [StaffID], onDelete: Cascade, map: "fk_sm_staff")
  student          student            @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade, map: "fk_sm_student")
  studentmentoring studentmentoring[]

  @@index([CollegeID], map: "fk_sm_college")
  @@index([StaffID], map: "fk_sm_staff")
  @@index([StudentID], map: "fk_sm_student")
}

model studentmentoring {
  StudentMentoringID     Int                                @id @default(autoincrement())
  StudentMentorID        Int
  DateOfMentoring        DateTime?                          @db.Date
  ScheduledMeetingDate   DateTime?                          @db.Date
  NextMentoringDate      DateTime?                          @db.Date
  IssuesDiscussed        String?                            @db.Text
  MentoringMeetingAgenda String?                            @db.Text
  AttendanceStatus       studentmentoring_AttendanceStatus?
  AbsentRemarks          String?                            @db.Text
  IsParentPresent        Boolean?                           @default(false)
  ParentName             String?                            @db.VarChar(50)
  ParentMobileNo         String?                            @db.VarChar(15)
  StudentsOpinion        String?                            @db.Text
  ParentsOpinion         String?                            @db.Text
  StaffOpinion           String?                            @db.Text
  StressLevel            studentmentoring_StressLevel?
  LearnerType            studentmentoring_LearnerType?
  MentoringDocument      String?                            @db.VarChar(255)
  Description            String?                            @db.Text
  CreatedAt              DateTime?                          @default(now()) @db.DateTime(0)
  UpdatedAt              DateTime?                          @default(now()) @db.DateTime(0)
  studentmentor          studentmentor                      @relation(fields: [StudentMentorID], references: [StudentMentorID], onDelete: Cascade, map: "fk_mentoring_sm")

  @@index([StudentMentorID], map: "fk_mentoring_sm")
}

model users {
  UserID       Int        @id @default(autoincrement())
  CollegeID    Int
  Name         String     @db.VarChar(50)
  Email        String     @unique(map: "Email") @db.VarChar(100)
  PasswordHash String     @db.VarChar(255)
  Role         users_Role
  IsActive     Boolean?   @default(true)
  CreatedAt    DateTime?  @default(now()) @db.DateTime(0)
  UpdatedAt    DateTime?  @default(now()) @db.DateTime(0)
  staff        staff[]
  student      student[]
  college      college    @relation(fields: [CollegeID], references: [CollegeID], onDelete: Cascade, map: "fk_users_college")

  @@index([CollegeID], map: "fk_users_college")
}

enum users_Role {
  ADMIN
  STAFF
  STUDENT
}

enum studentmentoring_AttendanceStatus {
  PRESENT
  ABSENT
}

enum studentmentoring_StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum studentmentoring_LearnerType {
  FAST
  AVERAGE
  ADVANCED
}
