generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model college {
  CollegeID     Int             @id @default(autoincrement())
  CollegeName   String          
  CollegeCode   String          @unique(map: "CollegeCode") 
  Email         String?         
  IsActive      Boolean?        @default(true)
  CreatedAt     DateTime?       @default(now()) 
  UpdatedAt     DateTime?       @default(now()) 
  Address       String?         
  Phone         String?         
  mentor        mentor[]
  student       student[]
  studentmentor studentmentor[]
  users         users[]
}

model mentor {
  MentorID      Int             @id @default(autoincrement())
  UserID        Int
  CollegeID     Int
  MentorName    String          
  MobileNo      String?         
  EmailAddress  String?         
  Department    String?         
  Education     String?         
  Feedback      Int?
  Description   String?         
  CreatedAt     DateTime?       @default(now()) 
  UpdatedAt     DateTime?       @default(now()) 
  college       college         @relation(fields: [CollegeID], references: [CollegeID], map: "fk_mentor_college")
  users         users           @relation(fields: [UserID], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "fk_mentor_user")
  studentmentor studentmentor[]

  @@index([CollegeID], map: "fk_mentor_college_idx")
  @@index([UserID], map: "fk_mentor_user_idx")
}

model passwordresettoken {
  email        String
  token        String   @unique(map: "PasswordResetToken_token_key")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  resettokenid Int      @id @default(autoincrement())
}

model student {
  StudentID     Int             @id @default(autoincrement())
  UserID        Int
  CollegeID     Int
  StudentName   String          
  EnrollmentNo  String          @unique(map: "EnrollmentNo") 
  MobileNo      String?         
  EmailAddress  String?         
  Description   String?         
  CreatedAt     DateTime?       @default(now()) 
  UpdatedAt     DateTime?       @default(now()) 
  Status        Boolean?        @default(true)
  CurrentSem    Int?
  Department    String?         
  college       college         @relation(fields: [CollegeID], references: [CollegeID], map: "fk_student_college")
  users         users           @relation(fields: [UserID], references: [UserID], onDelete: Cascade, map: "fk_student_user")
  studentmentor studentmentor[]

  @@index([CollegeID], map: "fk_student_college_idx")
  @@index([UserID], map: "fk_student_user_idx")
}

model studentmentor {
  StudentMentorID  Int                @id @default(autoincrement())
  StudentID        Int
  MentorID         Int
  CollegeID        Int
  FromDate         DateTime           
  ToDate           DateTime?          
  Description      String?            
  CreatedAt        DateTime?          @default(now()) 
  UpdatedAt        DateTime?          @default(now()) 
  college          college            @relation(fields: [CollegeID], references: [CollegeID], map: "fk_sm_college")
  mentor           mentor             @relation(fields: [MentorID], references: [MentorID], onDelete: Cascade, map: "fk_sm_mentor")
  student          student            @relation(fields: [StudentID], references: [StudentID], onDelete: Cascade, map: "fk_sm_student")
  studentmentoring studentmentoring[]

  @@index([CollegeID], map: "fk_sm_college_idx")
  @@index([MentorID], map: "fk_sm_mentor_idx")
  @@index([StudentID], map: "fk_sm_student_idx")
}

model studentmentoring {
  StudentMentoringID     Int                                @id @default(autoincrement())
  StudentMentorID        Int
  DateOfMentoring        DateTime?                          
  ScheduledMeetingDate   DateTime?                          
  NextMentoringDate      DateTime?                          
  IssuesDiscussed        String?                            
  MentoringMeetingAgenda String?                            
  AttendanceStatus       studentmentoring_AttendanceStatus?
  AbsentRemarks          String?                            
  IsParentPresent        Boolean?                           @default(false)
  ParentName             String?                            
  ParentMobileNo         String?                            
  StudentsOpinion        String?                            
  ParentsOpinion         String?                            
  StaffOpinion           String?                            
  StressLevel            studentmentoring_StressLevel?
  LearnerType            studentmentoring_LearnerType?
  MentoringDocument      String?                            
  Description            String?                            
  CreatedAt              DateTime?                          @default(now()) 
  UpdatedAt              DateTime?                          @default(now()) 
  studentmentor          studentmentor                      @relation(fields: [StudentMentorID], references: [StudentMentorID], onDelete: Cascade, map: "fk_mentoring_sm")

  @@index([StudentMentorID], map: "fk_mentoring_sm_idx")
}

model users {
  UserID            Int           @id @default(autoincrement())
  CollegeID         Int
  Name              String        
  Email             String        @unique(map: "Email") 
  PasswordHash      String        
  Role              users_Role
  IsActive          Boolean?      @default(true)
  CreatedAt         DateTime?     @default(now()) 
  UpdatedAt         DateTime?     @default(now()) 
  EmailVerified     Boolean?      @default(false)
  EmailVerifyToken  String?       
  EmailVerifyExpiry DateTime?     
  mentor            mentor[]
  student           student[]
  college           college       @relation(fields: [CollegeID], references: [CollegeID], onDelete: Cascade, map: "fk_users_college")
  usersession       usersession[]

  @@index([CollegeID], map: "fk_users_college_idx")
}

model usersession {
  id        Int       @id @default(autoincrement())
  token     String    @unique(map: "token") 
  userId    Int
  expiresAt DateTime  
  createdAt DateTime? @default(now()) 
  users     users     @relation(fields: [userId], references: [UserID], onDelete: Cascade, onUpdate: NoAction, map: "usersession_ibfk_1")

  @@index([userId], map: "userId_idx")
}

enum users_Role {
  ADMIN
  MENTOR
  STUDENT
}

enum studentmentoring_AttendanceStatus {
  PRESENT
  ABSENT
}

enum studentmentoring_StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum studentmentoring_LearnerType {
  FAST
  AVERAGE
  ADVANCED
}
